# ──────────────────────────────────────────────────────────────────────────────
# LaundryLink / PurePress Laundry — Environment Variables
# Copy this file to .env and fill in real values before running the app.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Runtime environment ────────────────────────────────────────────────────
# One of: development | staging | production
# In production, missing required vars become hard errors.
EXPO_PUBLIC_APP_ENV=development

# ── Metro bundler (Replit / CI) ────────────────────────────────────────────
CI=1
EXPO_NO_TELEMETRY=1

# ── Supabase (REQUIRED for live mode) ─────────────────────────────────────
# Without these, the app runs in demo mode (local storage only).
# Get these from: Supabase Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Paystack (REQUIRED for real payments) ─────────────────────────────────
# Without this, PaymentModal shows bank-transfer simulation only.
# Test keys start with pk_test_  |  Live keys start with pk_live_
# Get from: Paystack Dashboard → Settings → API Keys & Webhooks
EXPO_PUBLIC_PAYSTACK_KEY=pk_test_your_paystack_public_key

# ── API Server (REQUIRED for webhooks and cross-device push) ──────────────
# URL of the deployed Express API server (artifacts/api-server).
# For local dev with proxy: leave blank or use the Replit preview URL.
# For production: https://api.purepresslaundry.com
EXPO_PUBLIC_API_URL=

# ── Admin access ───────────────────────────────────────────────────────────
# Passphrase for session-based Super Admin elevation.
# Recommended: set user_metadata.admin_tier = "SUPER" in Supabase dashboard
# instead of relying on a passphrase in production.
# If not set, passphrase unlock is disabled.
EXPO_PUBLIC_ADMIN_PASSPHRASE=
