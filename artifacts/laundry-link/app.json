{
  "expo": {
    "name": "LaundryLink",
    "slug": "laundry-link",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "laundry-link",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1d38"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.laundrylink.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "LaundryLink uses your camera for KYC verification photo.",
        "NSPhotoLibraryUsageDescription": "LaundryLink accesses your photo library for KYC verification.",
        "NSLocationWhenInUseUsageDescription": "LaundryLink uses your location to show nearby laundromats and track deliveries.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.laundrylink.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0a1d38"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0a1d38",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LaundryLink uses your location to show nearby laundromats."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "42ccd3f0-2dbc-4189-a061-addf0c2670a5"
      }
    },
    "owner": "codebruv"
  }
}
